{
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "__OPENCLAW_GATEWAY_TOKEN__"
    }
  },
  "commands": {
    "bash": true
  },
  "agents": {
    "defaults": {
      "verboseDefault": "full"
    }
  },
  "tools": {
    "profile": "full",
    "alsoAllow": ["exec"],
    "exec": {
      "host": "gateway",
      "security": "full",
      "ask": "off"
    },
    "elevated": {
      "enabled": true,
      "allowFrom": {
        "tui": ["*"],
        "webchat": ["*"]
      }
    }
  }
}
